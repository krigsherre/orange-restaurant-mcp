# Copy to .env — orange loads it automatically on every CLI run.
# Variables already exported in the shell take precedence over the file.
#
# Live mode — leave unset to use the bundled fixtures.
# Swiggy Builders Club OAuth access token for the Dineout server.
SWIGGY_MCP_TOKEN=
# District publishes no stable public MCP endpoint; set one if you have partner access.
DISTRICT_MCP_ENDPOINT=
DISTRICT_MCP_TOKEN=
# Enables the LLM offer judge (DeepSeek). Without it the rubric judge runs.
DEEPSEEK_API_KEY=
# LLM scoring switch: auto (default: on when the key is set), on, off.
# The --llm CLI flag wins over this value.
ORANGE_LLM=
# Optional DeepSeek overrides (defaults shown).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
